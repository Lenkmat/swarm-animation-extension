{
  "manifest_version": 3,
  "name": "Swarm Animation Player",
  "version": "1.0.0",
  "description": "在任意网页上播放 swarm-animation 的「团队构建页面」动画：手动播放、新网页自动播放、黑名单/白名单管理。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Swarm Animation Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
